local M = {}


local SCRIPT_TEMPLATE = [[
function init(self)
end


function final(self)
end


function update(self, dt)
end


function on_message(self, message_id, message, sender)
end


function on_input(self, action_id, action)
end


function on_reload(self)
end
]]


local function trim(value)
    return value:gsub("^%s+", ""):gsub("%s+$", "")
end


local function get_directory(selection)
    local selected_path = editor.get(selection, "path")

    if not selected_path then
        return nil
    end

    local attributes = editor.resource_attributes(selected_path)

    -- Если ПКМ был сделан по папке
    if attributes.is_directory then
        return selected_path
    end

    -- Если выбран файл — используем его папку
    local directory = selected_path:match("^(.*)/[^/]+$")

    if directory then
        return directory
    end

    return "/"
end


local function resource_exists(path)
    local attributes = editor.resource_attributes(path)
    return attributes.exists
end


function M.get_commands()

    return {
        {
            label = "Create GUI + Script",

            locations = {"Assets"},

            query = {
                selection = {
                    type = "resource",
                    cardinality = "one"
                }
            },

            active = function(opts)
                return true
            end,

            run = function(opts)

                ------------------------------------------------------------
                -- Определяем папку
                ------------------------------------------------------------

                local directory = get_directory(opts.selection)

                if not directory then
                    print("Create GUI + Script: no directory selected")
                    return
                end


                ------------------------------------------------------------
                -- Запрашиваем имя
                ------------------------------------------------------------

                local name = ""


                local result = editor.ui.show_dialog(
                editor.ui.dialog({
                    title = "Create GUI + Script",

                    content = editor.ui.vertical({
                        padding = editor.ui.PADDING.LARGE,

                        children = {

                            editor.ui.label({
                                text = "Enter GUI name:"
                            }),

                            editor.ui.string_field({
                                value = name,

                                on_value_changed = function(value)
                                    name = value
                                end
                            })
                        }
                    }),

                    buttons = {

                        editor.ui.dialog_button({
                            text = "Cancel",
                            cancel = true
                        }),

                        editor.ui.dialog_button({
                            text = "Create",
                            default = true,
                            result = true
                        })
                    }
                })
            )


            ------------------------------------------------------------
            -- Cancel
            ------------------------------------------------------------

            if not result then
                return
            end


            ------------------------------------------------------------
            -- Проверяем имя
            ------------------------------------------------------------

            name = trim(name)


            if name == "" then
                print("Create GUI + Script: name is empty")
                return
            end


            ------------------------------------------------------------
            -- Убираем расширения, если пользователь их ввёл
            ------------------------------------------------------------

            name = name:gsub("%.gui$", "")
            name = name:gsub("%.gui_script$", "")


            ------------------------------------------------------------
            -- Запрещаем пути внутри имени
            ------------------------------------------------------------

            name = name:gsub("[/\\]", "_")


            ------------------------------------------------------------
            -- Формируем пути
            ------------------------------------------------------------

            if directory ~= "/" then
                directory = directory:gsub("/$", "")
            end

            local gui_path

            if directory == "/" then
                gui_path = "/" .. name .. ".gui"
            else
                gui_path = directory .. "/" .. name .. ".gui"
            end

            local script_path =
            gui_path:gsub("%.gui$", ".gui_script")


            ------------------------------------------------------------
            -- Проверяем существование
            ------------------------------------------------------------

            if resource_exists(gui_path) then
                print(
                "Create GUI + Script: GUI already exists: " ..
                gui_path
            )
            return
        end


        if resource_exists(script_path) then
            print(
            "Create GUI + Script: script already exists: " ..
            script_path
        )
        return
    end


    ------------------------------------------------------------
    -- Создаём корректный .gui
    --
    -- Это настоящий Defold GUI resource.
    ------------------------------------------------------------

    local gui_content = string.format(
    [[script: "%s"

    fonts {
        name: "default"
        font: "/builtins/fonts/default.font"
    }

    material: "/builtins/materials/gui.material"

    adjust_reference: ADJUST_REFERENCE_PARENT
    ]],
    script_path
)


------------------------------------------------------------
-- Создаём оба ресурса через API Defold
------------------------------------------------------------

local success, error_message = pcall(
function()

    editor.create_resources({
        {
            gui_path,
            gui_content
        },

        {
            script_path,
            SCRIPT_TEMPLATE
        }
    })

end
)


------------------------------------------------------------
-- Ошибка
------------------------------------------------------------

if not success then

print(
"Create GUI + Script failed: " ..
tostring(error_message)
)

return
end


------------------------------------------------------------
-- Готово
------------------------------------------------------------

print(
"Created GUI + Script:\n" ..
gui_path .. "\n" ..
script_path
)


------------------------------------------------------------
-- Открываем GUI
------------------------------------------------------------

editor.ui.open_resource(gui_path)

end
}
}

end


return M